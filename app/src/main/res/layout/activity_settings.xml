<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:paddingBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_base_url" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <EditText android:id="@+id/baseUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:hint="https://od-byd-seal.example.com"
            android:autofillHints="" android:paddingBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_edge_auth" android:textAppearance="?attr/textAppearanceLabelLarge"
            android:paddingTop="8dp" />
        <Spinner android:id="@+id/edgeType" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:paddingBottom="12dp" />

        <LinearLayout android:id="@+id/cfBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_cf_id" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <EditText android:id="@+id/cfClientId" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:autofillHints="" android:hint="xxxx.access" android:paddingBottom="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings_cf_secret" android:textAppearance="?attr/textAppearanceLabelLarge" />
            <EditText android:id="@+id/cfClientSecret" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:autofillHints="" android:paddingBottom="12dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_device_token" android:textAppearance="?attr/textAppearanceLabelLarge"
            android:paddingTop="8dp" />
        <EditText android:id="@+id/deviceToken" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:autofillHints="" android:paddingBottom="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_device_token_hint" android:textAppearance="?attr/textAppearanceBodySmall"
            android:paddingBottom="20dp" />

        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_save" />

    </LinearLayout>
</ScrollView>
